# ── Booklith reader: bring-your-own-key ──────────────────────────────────────
# Nothing is hosted by Booklith. Set these in your Vercel project settings
# (never commit real values).

# API used by chat, translation, quizzes and reference search.
API_KEY=
# Optional endpoint and model for your compatible Chat Completions API.
# Defaults: https://api.openai.com/v1 and gpt-4o-mini.
API_BASE_URL=
API_MODEL=
# For Meta voice transcription and grounded search, set API_BASE_URL to
# https://api.meta.ai/v1 and choose a model supported by that endpoint.

# OmniVoice TTS on Modal (recommended, 600+ languages — the POST/clone
# endpoint from omnivoice_tts_modal.py). OPTIONAL: the Builder can also bake
# your URL into the exported repo (content/tts-url.json), and if no OmniVoice
# endpoint is available the reader automatically falls back to keyless voices
# (Microsoft Edge Read-Aloud, then an in-browser online voice). The URL/token
# NEVER reaches the browser — /api/tts proxies it server-side.
MODAL_TTS_URL=
# Optional: voice design instruction, e.g. "female, low pitch, british accent"
MODAL_TTS_INSTRUCT=
# Optional: JSON object of extra headers, e.g. {"Modal-Key":"...","Modal-Secret":"..."}
MODAL_TTS_HEADERS=

# Web search for the References feature (https://tavily.com — free tier).
# URLs are ALWAYS taken from search results and verified with a real request;
# never from the model's memory.
TAVILY_API_KEY=
